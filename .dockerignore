# Build context exclusions. Keep this list tight: everything not excluded is
# sent to the Docker daemon on every build.

# --- dependencies (reinstalled inside the image) ---
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- build output ---
.next
out
build
*.tsbuildinfo

# --- vcs / ci ---
.git
.gitignore
.gitattributes
.github
.vercel

# --- local env & secrets (injected at runtime instead) ---
.env
.env.*
*.pem

# --- editor / os noise ---
.vscode
.idea
.DS_Store
Thumbs.db

# --- docker files themselves ---
Dockerfile
.dockerignore
docker-compose.yml

# --- logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# NOTE: src/data/**/*.md is deliberately NOT excluded — the app reads those
# markdown files from disk at runtime (blog + customer routes).
